# Your own bot (Developer Portal -> New Application -> Bot). Never commit .env.
DISCORD_BOT_TOKEN=
# Application ID (General Information page); only used by `npm run deploy`
DISCORD_CLIENT_ID=
# Server ID(s), comma separated. Bot ignores every other server; `npm run deploy` registers commands here.
ALLOWED_GUILD_IDS=950341759085461504
# Optional: user IDs who can always run /reactionlog (otherwise Manage Server / Admin can)
DISCORD_OWNER_USER_IDS=
# Optional: voice channel ID the bot sits in 24/7 (blank = off)
VOICE_CHANNEL_ID=1500141050814267515
